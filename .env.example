# Copy this file to .env and fill in values locally when using real LLMs.
# Data preparation and offline tests do not require these credentials.
# Groq-hosted GPT-OSS 120B, routed through LiteLLM.
LLM_PROVIDER=groq
LLM_MODEL=groq/openai/gpt-oss-120b
# Put your Groq API key here in .env (not in this template).
LLM_API_KEY=

# Required for the complete evaluation with the LLM judge.
JUDGE_PROVIDER=groq
JUDGE_MODEL=groq/openai/gpt-oss-120b
# May use the same Groq API key; only needed for evaluation.
JUDGE_API_KEY=

# Keep downloaded embedding weights inside the ignored project cache.
HF_HOME=.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1

# Use the bundled LiteLLM model metadata instead of fetching it at import time.
LITELLM_LOCAL_MODEL_COST_MAP=True
